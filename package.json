{
  "name": "gh-skills",
  "version": "1.0.0",
  "description": "GitHub pull request automation skills for AI coding agents",
  "homepage": "https://github.com/odykyi/gh-skills",
  "license": "MIT",
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "diagram": "./assets/build-diagram.sh",
    "test": "node scripts/validate-skills.mjs && node --test test/*.test.mjs && node evals/run-reference.mjs && node evals/report.mjs --check",
    "eval": "node evals/run-reference.mjs",
    "eval:llm": "node evals/run-llm.mjs",
    "eval:report": "node evals/report.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "skills",
    "assets",
    "rules",
    "template",
    "docs",
    "install.sh",
    "llms.txt",
    "SPEC.md",
    "AGENTS.md"
  ]
}
