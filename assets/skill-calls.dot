// gh-skills — the factory: what happens to a pull request, and how long it takes.
// Render:  ./assets/build-diagram.sh   (dot + animated-SVG injection)
// Source of truth: this file. The SVG in assets/ is generated from it.
digraph SKILL_FACTORY {
  rankdir=TB;
  splines=polyline;
  bgcolor="transparent";
  pad="0.35";
  nodesep="0.34";
  ranksep="0.62";
  fontname="Helvetica,Arial,sans-serif";

  node [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif",
        fontsize=13, fontcolor="#111827", color="#4F46E5", fillcolor="#EEF2FF",
        penwidth=1.6, margin="0.16,0.10"];
  edge [color="#9CA3AF", fontname="Helvetica,Arial,sans-serif", fontsize=10,
        fontcolor="#6B7280", arrowsize=0.7, penwidth=1.2];

  // ---------------- intake ----------------
  queue [label=<<b>Your queue</b><br/><font point-size="10" color="#B45309">30 open PRs</font>>,
         shape=note, fillcolor="#FEF3C7", color="#D97706", penwidth=1.8];
  mgr   [label=<<b>pr-manager</b><br/><font point-size="10" color="#6D28D9">one lane per PR · ~1s</font>>,
         shape=box3d, fillcolor="#F5F3FF", color="#7C3AED"];
  orch  [label=<<b>pr-workflow-orchestrator</b><br/><font point-size="10" color="#6D28D9">the line manager · ~1s</font>>,
         shape=box3d, fillcolor="#F5F3FF", color="#7C3AED"];

  // side stations that feed the queue
  proj [label=<<b>gh-project-orchestrator</b><br/><font point-size="10" color="#047857">epics + tasks · ~10s</font>>,
        fillcolor="#ECFDF5", color="#059669"];
  prio [label=<<b>gh-prioritizer</b><br/><font point-size="10" color="#047857">what is urgent · ~10s</font>>,
        fillcolor="#ECFDF5", color="#059669"];
  digest [label=<<b>pr-queue-digest</b><br/><font point-size="10" color="#047857">read-only queue view · ~5s</font>>,
        fillcolor="#ECFDF5", color="#059669"];
  driver [label=<<b>pr-initiative-driver</b><br/><font point-size="10" color="#6D28D9">repeating cycle · every ~10m</font>>,
        shape=box3d, fillcolor="#F5F3FF", color="#7C3AED"];
  btns [label=<<b>gh-pr-review-buttons</b><br/><font point-size="10" color="#4B5563">AI review badges · one-time</font>>,
        fillcolor="#F3F4F6", color="#9CA3AF"];

  // ---------------- the line ----------------
  subgraph cluster_lane {
    label=<<b>One pull request, start to finish</b>>;
    fontname="Helvetica,Arial,sans-serif"; fontsize=12; fontcolor="#374151";
    color="#E5E7EB"; style="rounded,dashed"; penwidth=1.4; bgcolor="#FAFAFB";

    wt    [label=<<b>Isolate the work</b><br/><font point-size="10" color="#9A3412">pr-worktree · ~5s</font>>,
           fillcolor="#FFF7ED", color="#F97316"];
    impl  [label=<<b>Write the code</b><br/><font point-size="10" color="#9A3412">the agent · 1-30m</font>>,
           fillcolor="#FFF7ED", color="#F97316"];
    open  [label=<<b>Open the PR</b><br/><font point-size="10" color="#9A3412">pr-opener · ~10s</font>>,
           fillcolor="#FFF7ED", color="#F97316"];
    lab   [label=<<b>Label it right</b><br/><font point-size="10" color="#9A3412">pr-labeler · ~5s</font>>,
           fillcolor="#FFF7ED", color="#F97316"];
    ci    [class="pulse", label=<<b>Pass the checks</b><br/><font point-size="10" color="#92400E">CI · ~60s</font>>,
           shape=diamond, fillcolor="#FEF9C3", color="#EAB308", penwidth=1.8];
    rev   [class="pulse", label=<<b>Get reviewed</b><br/><font point-size="10" color="#92400E">pr-reviewer · ~60s</font>>,
           shape=diamond, fillcolor="#FEF9C3", color="#EAB308", penwidth=1.8];
    fb    [class="pulse", label=<<b>Handle the feedback</b><br/><font point-size="10" color="#991B1B">pr-feedback-handler · ~30s</font>>,
           fillcolor="#FEE2E2", color="#EF4444"];
    cmt   [label=<<b>Answer in thread</b><br/><font point-size="10" color="#991B1B">pr-commenter · ~10s</font>>,
           fillcolor="#FEE2E2", color="#EF4444"];
    mrg   [class="pulse", label=<<b>Merge safely</b><br/><font point-size="10" color="#047857">pr-merger · ~15s</font>>,
           shape=box3d, fillcolor="#ECFDF5", color="#10B981"];
    clean [class="pulse", label=<<b>Clean up</b><br/><font point-size="10" color="#047857">worktree + branch · ~5s</font>>,
           fillcolor="#ECFDF5", color="#10B981"];
    done  [class="pulse", label=<<b>Shipped</b><br/><font point-size="10" color="#065F46">issue linked + merged</font>>,
           shape=octagon, fillcolor="#D1FAE5", color="#10B981", penwidth=2];

    wt -> impl -> open -> lab -> ci -> rev;
    rev -> fb [label=" changes requested ", color="#DC2626", fontcolor="#DC2626"];
    rev -> cmt [label=" comment ", color="#DC2626", fontcolor="#DC2626"];
    cmt -> fb [style=dashed, color="#F87171"];
    ci  -> fb [label=" failing ", color="#DC2626", fontcolor="#DC2626"];
    fb  -> impl [label=" fix and push ", style=dashed, color="#EF4444", fontcolor="#DC2626",
                 constraint=false];
    fb  -> mrg [label=" approved "];
    mrg -> clean -> done;

    // stage ranks inside the line
                      { rank=same; done; }
  }

  // ---------------- the promise ----------------
  promise [label=<<font point-size="11" color="#047857"><b>Every PR ends the same way:</b></font><br/><font point-size="10" color="#065F46">issue linked · CI green · approved · merged · worktree removed</font>>,
            shape=plaintext, fillcolor="none", color="none"];

  // ---------------- edges ----------------
  queue -> mgr [label=" 20+ lanes "];
  mgr -> orch;
  orch -> wt [label=" dispatch "];
  proj -> queue [style=dashed, color="#10B981", fontcolor="#047857"];
  prio -> queue [style=dashed, color="#10B981", fontcolor="#047857"];
  driver -> mgr [style=dashed, color="#7C3AED", fontcolor="#6D28D9", label=" next cycle "];
  digest -> queue [style=dashed, color="#10B981", fontcolor="#047857"];
  btns -> open [style=dashed, color="#9CA3AF", fontcolor="#6B7280", label=" badges on the PR "];
  done -> promise [style=invis];

  // ---------------- ranks ----------------
  { rank=same; queue; proj; prio; digest; btns; }
  { rank=same; mgr; driver; }
  { rank=same; orch; }
  { rank=same; promise; }
}
